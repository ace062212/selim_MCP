# 복사해서 .env 로 저장 후 값 채우기:  cp .env.example .env
# 비밀값 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=8080
NODE_ENV=development

# PostgreSQL 접속 정보
DATABASE_URL=postgres://selim_mcp:비밀번호@localhost:5432/selim_mcp

# 세션 토큰 서명 키 (32자 이상 랜덤 문자열)
SESSION_SECRET=
# 인증번호 해시용 비밀값 (32자 이상 랜덤 문자열)
OTP_PEPPER=

# 최초 관리자 이메일 (쉼표로 여러 개). admins 테이블이 비어 있을 때만 등록됨
INITIAL_ADMIN_EMAILS=

# 개발용: 메일 발송 없이 아무 6자리나 통과 (운영에서는 반드시 false, true면 서버가 시작을 거부함)
OTP_DEV_ACCEPT_ANY=true

# 프론트 빌드 결과물을 이 서버가 같이 내려줄 때 경로 (비우면 API만 제공)
FRONT_DIST=../front/dist

# nginx 등 프록시 뒤에 둘 때 true (접속자 IP를 X-Forwarded-For에서 읽음)
TRUST_PROXY=false
